# =============================================================================
# AgriPilot BD Environment Configuration Template
# =============================================================================

# Project
PROJECT_NAME="AgriPilot BD Backend API"
VERSION="1.0.0"

# Database Configuration (PostgreSQL / SQLite)
# For local zero-setup dev: sqlite:///./agripilot.db
# For production PostgreSQL / Supabase: postgresql+psycopg://postgres:password@localhost:5432/agripilot
DATABASE_URL=sqlite:///./agripilot.db

# JWT & Security
SECRET_KEY=agripilot_bd_production_secure_secret_key_2026_bd
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","*"]

# External Services
WEATHER_CACHE_TTL_SECONDS=3600
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Copernicus Sentinel-2 Satellite (Optional for Phase 2)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
